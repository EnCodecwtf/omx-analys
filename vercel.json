{
  "rewrites": [{ "source": "/(.*)", "destination": "/api?__path=/$1" }],
  "functions": {
    "api/index.js": { "includeFiles": "{public/**,symbols.json,data/**}", "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron/scan", "schedule": "0 17 * * *" },
    { "path": "/api/cron/shorts", "schedule": "15 17 * * 1-5" },
    { "path": "/api/cron/us", "schedule": "30 21 * * *" }
  ]
}
